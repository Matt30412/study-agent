# Copy to .env and fill in. The service URLs default to the values below,
# which match docker-compose.yml: you only need them if you run things elsewhere.

# --- Dev mode: `python -m src.app` (local users, no Google) -----------------------
# Comma-separated username:password pairs. The username is the owner_id, so it has
# to match the --owner you used for ingestion.
APP_USERS=alice:change-me

# --- Google login: `python -m uvicorn src.server:app` -----------------------------
# OAuth client of type "Web application" from Google Cloud Console, with
# http://localhost:8000/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID= pippo
GOOGLE_CLIENT_SECRET= paperino
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Comma-separated Google accounts allowed to log in. Empty = nobody gets in.
ALLOWED_EMAILS=you@gmail.com
# Defaults to true (Secure cookie). Set false only for local development over http://.
SESSION_HTTPS_ONLY=false

# --- Services ----------------------------------------------------------------------
DATABASE_URL=postgresql://study_agent:study_agent@localhost:5432/study_agent
QDRANT_URL=http://localhost:6333
# Read directly by the ollama client library.
OLLAMA_HOST=http://localhost:11434
